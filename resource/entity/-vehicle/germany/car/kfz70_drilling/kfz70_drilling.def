{game_entity
	(include "/properties/car.ext")
	(include "/properties/selection/vehicle.inc" scale(1.0))
	{props "multi_board" "truck" "tank" "halftrack" "vision_lev02" "tractor" "turret" "with_gun" "automatic" "tractor_medium" "detect_tank_mg" "open_death_fx_low" "open_top" "Captor"}
	{able "emit_on_attack"}
	{extension "kfz70.mdl"}
	{collider "truck"}
	{patherId "blitz36"}
	{targetclass "armoredcar"}
	{targetSelector "cannon_zenite"}

	{extender "shield" {on}}

	{extender "enumerator"
		{digit_folder "np"}
	}

	("gun_shield" args "gun_shield" 8)

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelright3")
	("wheel" args "wheelleft2")
	("wheel" args "wheelleft3")

	("glass" args "glass1")
	("glass" args "glass2")
	("fuel" args "fuel")
	("transmission" args "transmission")
	
	("gun" repair(30) thickness(8))

	("bodyback" repair(30))

	("shield_cover")

	{volume "body2" {able {holed}}}
	{volume "bodyback1" {able {holed}}}
	{volume "bodyback2" {able {holed}}}
	{volume "shield_cover" {able {holed}}}

	("wood" args "bodyback1")
	("wood" args "bodyback2")
	("wood" args "bodyback3")
	("wood" args "bodyback4")
	
	{boarder
		{anm "driver"
			{forward {begin "board_SdKfz251-1"} {end "pose_kfz70_driver"} {base "board"}}
			{reverse {end "board_SdKfz251-1" 1} {base "board"}}
		}
		{anm "commander"
			{forward {begin "board_SdKfz251-1"} {end "pose_kfz70_commander"} {base "board"}}
			{reverse {end "board_SdKfz251-1" 1} {base "board"}}
		}		
		{anm "gunner"
			{forward {begin "board_body"} {end "seat_251_21_gunner"} {base "board"}}
			{reverse {end "board_body" 1} {base "board"}}
		}		
		{anm "charger"
			{forward {begin "board_body"} {end "seat_251_21_charger"} {base "board"}}
			{reverse {end "board_body" 1} {base "board"}}
		}
		
	}
	
	("crew" place(driver)		bone(driver)	door(emit1)	animation(driver)	 visor(main) off({sensor}))
	("crew" place(commander)		bone(commander)	door(emit2)	animation(commander)	 visor(around) off())
	("crew" place(gunner)		bone(gunner)	door(emit3)	animation(gunner)	 visor(gunner) off({sensor}))	
	("crew" place(charger)		bone(charger)	door(emit3)		animation(charger)		visor(none)		off())	
	
	{placer
		{place "driver"		{visor "main"}}
		{place "commander"	{visor "commander"} {group "crew"}}
		{place "gunner"		{visor "around"} {group "crew"} {turnoff {targetable 0}}}
	}	
	
	{sensor
		{visor "main"
			{bone "visor2"}		
			{vision "human"}
		}
		{visor "commander"
			{bone "visor1"}
			{vision "human"}
		}
	}		

	{extender "inventory"
		{box
			{item "bulletger_15_auto he" 2225}
			{item "bulletger_15_auto ap" 325}			
		}
	}
	
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "15mm_mg151_x3" filling "bulletger_15_auto he" 450}
			{Barrels 3}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_aaa"
				zeroing(1.2)
				dispersion(0.15)
			)
		}
	}	

	{mass 2600}
	{Chassis
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel03d") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
		("mobility_car"
			speed(70) ;----------------------------------Max speed.
			speedatmaxturn(15) ;-------------------------Max speed at max turn.
			reverse(22) ;--------------------------------Max speed in Reverse.
			weight(2.6) ;--------------------------------Weight in Tonnes.
			power(60) ;----------------------------------Horse Power.
			fuel(110) ;----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(230) ;---------------------------------Range in Kilometers.
		)
	}
	
	{bone "gun_rot"
		{limits -5 49}
		{speed2 20}
	}
	{bone "turret"
		{speed2 25}
	}	
}


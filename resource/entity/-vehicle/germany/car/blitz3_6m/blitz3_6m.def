{game_entity
  (include "/properties/car.ext")
  (include "/properties/selection/vehicle.inc"  scale(1.1))
  {collider "truck"}
  {props "vehicle" "car" "wheeled" "truck" "vision_lev02"}
  {able "emit_on_attack"}
  {patherId "blitz36"}  
  {Extension "blitz3_6m.mdl"} 

  ("crew_2_human")
  
	("board_animation"
		place(driver)
		board_begin(board_opel_driver)
		board_end(seat_opel_driver)
		base(doorleft)
	)
	("board_animation"
		place(commander)
		board_begin(board_big-highcar)
		board_end(seat_opel_commander)
		base(doorright)
	)

  {boarder
    {anm "passenger"
      {forward  {begin  "board_body"} {end "seat_passenger"}}
      {reverse  {end  "emit_body" 1}}
    }
  }

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")
  
 	("glass" args "glassr")
	("glass" args "glassl")
	("glass" args "glass")
	("fuel" args "fuel") 
  
	{Volume "bodyback"
		{thickness 6}
	}
  
	("bodyback" repair(30))

	{extender "inventory"
		{box
		        {item "m24_smoke grenade" 20}
                        {item "m24_splinter grenade" 10}
		        {item "bandage_ger" 80}
		        {item "tent_kit" 6}
		        {item "luger" 6}
		        {item "pistol ammo" 600}
		}
	}
  
	{mass 2100}
	{Chassis
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel03d") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
		("mobility_car"
			speed(80) ;----------------------------------Max speed.
			speedatmaxturn(15) ;-------------------------Max speed at max turn.
			reverse(32) ;--------------------------------Max speed in Reverse.
			weight(2.1) ;--------------------------------Weight in Tonnes.
			power(68) ;----------------------------------Horse Power.
			fuel(80) ;-----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(230) ;---------------------------------Range in Kilometers.
		)
	}
}

{game_entity
	(include "/properties/tank.ext")	
	(include "/properties/selection/vehicle_elongated.inc" scale(0.95))
	{props "light" "tank" "turret" "wheeled" "-hatch" "with_gun" "vision_lev02" "muzzle_20mm_25mm_auto"}
	{targetClass "light_tank"}
	{targetSelector "tank_zenite"}
	{extension "crew.ext"}
	{patherId "panzer1"}
	{collider "tank.light"}
	{Extension "pz1.mdl"}	
	(include "flakpanzer1.ext")
	
	{extender "shield" {on}}
	
	{extender "enumerator"
		{digit_folder "ger"}
	}
	
	{extender "inventory"
		{box
			{item "bulletger_20_auto ap" 140}
			{item "bulletger_20_auto he" 240}	
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{weapon "20mm_flak38" filling "bulletger_20_auto he" 20}
			("abm_dymamic_aaa"
				zeroing(2.9)
				dispersion(0.08)
			)
			{charger "gunner"}		
			{charger "charger"}					
		}
	}

	{mass 5400}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.15) len(0.43))
		("mobility_tank"
			speed(35) ;----------Max speed when fully accelerated on road, km/h.
			reverse(6) ;---------Max speed in reverse on road, km/h.
			traverse(32) ;-------Track traverse, per second, in degrees.
			weight(6) ;--------Weight in Tonnes.
			power(60) ;---------Engine Power, in hp.
			track(4) ;-----------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(114) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(115) ;---------Range in km, off-road.
		)
	}

	{bone "gun_rot"
		{limits -10 30}
	}
	{bone "turret"
		{speed 0.02}
	}
}

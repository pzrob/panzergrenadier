{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle_elongated.inc" scale(1.0))
        {props "with_gun" "katusha" "truck" "vision_lev06" "detect_artillery" "artillery_minimap_medium" "captor" "support_open_ani"}
	{extension "sdkfz7_rocket.mdl"}
	(include "sdkfz7_rocket.ext")
        {extension "crew.ext"}
	{able "emit_on_attack"}
	{targetSelector "rocket"}
	{targetclass "howitzer"}
	{collider "truck"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	{extender "shield" {on}}

	{extender "inventory"
		{box
			{item "ammo 300mm_bm30" 12}		;2 salvos (12 rockets each) (24 total)
		}
	}

	{Weaponry
		{place "gun"
			{weapon "weapon 300mm_bm30" filled}
			{Barrels 12}
			{charger "driver"}
			{gunner "driver"}
			{StationaryFiring}
			("abm_dymamic_rocket"
				zeroing(10.0)	; // time it takes to aim until the reticle shrinks. Bigger values, more control.
				dispersion(1)   ; // time it takes to distort the reticle when you move the gun (how abrupt it loses zeroing). Bigger values, more control.
			)
		}
	}

	{mass 15000}
	{Chassis "wheel"
		("tank_trace" fx("tracks_mid") step(0.5) len(0.59) boneleft("FXtraceL2") boneright("FXtraceR2"))
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("mobility_car"
			speed(50) ;----------------------------------Max speed.
			speedatmaxturn(15) ;-------------------------Max speed at max turn.
			reverse(25) ;--------------------------------Max speed in Reverse.
			weight(15.0) ;-------------------------------Weight in Tonnes.
			power(130) ;---------------------------------Horse Power.
			fuel(203) ;----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(110) ;---------------------------------Range in Kilometers.
		)
		{DisableMoveWhileFiring}
	}
	{bone "gun_rot"
		{limits -6 40}
		{speed2 5}
	}
	{bone "turret"
		{limits -10 10}
		{speed2 5}
	}
	(mod "mp"
		{brain
			{properties
				{fire_mode hold}
			}
		}
	)
}
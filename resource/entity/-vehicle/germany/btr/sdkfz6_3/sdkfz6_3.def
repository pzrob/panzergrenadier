{game_entity
	(include "/properties/armoredcar.ext")	
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "td" "armored_car" "muzzle_75mm_76mm" "tank" "open_death_fx" "shell_eject" "open_top" "turret" "with_gun" "tractor" "tractor_medium" "vision_lev02" "detect_td_light" "open_death_fx" "steel" "shield"}
	{extension "sdkfz6_3.mdl"}
	(include "sdkfz6_3.ext")	
	{collider "truck"}
	{patherId "sdkfz8"}
	{targetclass "armoredcar"}
	{extension "crew.ext"}
	{targetSelector "tank_zenite"}	
	
	{extender "shield" {on}}	
	
	("crew_2_human")
	("crew_human"	place(driver)		door(emit1)	bone(driver)	animation(driver)	group(crew))
	("crew_human"	place(gunner)		door(emit3)	bone(gunner)	animation(gunner)	group(crew))
	("crew_human"	place(charger)		door(emit4)	bone(charger)	animation(charger)	group(crew))
	("crew_human"	place(charger2)		door(emit5)	bone(charger2)	animation(charger2)	group(crew))
	("crew_human"	place(commander)	door(emit2)	bone(commander)	animation(commander)	group(crew))	

	{boarder
		{anm "driver"
			{forward {begin "board_SdKfz251-1"} {end "seat_driver_car"}}
			{reverse {end "emit_body" 1}}
		}
		{anm "commander"
			{forward {begin "board_SdKfz251-1"} {end "seat_passenger"}}
			{reverse {end "emit_body" 1}}
		}
		{anm "gunner"
			{forward {begin "board_SdKfz251-1"} {end "pose_new_cannon_gunner_fire" 10}}
			{reverse {end "emit_body" 1}}
		}
		{anm "charger"
			{forward {begin "board_SdKfz251-1"} {end "pose_new_cannon_charger_fire" 10}}
			{reverse {end "emit_body" 1}}
		}
		{anm "charger2"
			{forward {begin "board_SdKfz251-1"} {end "pose_new_cannon_charger_fire" 10}}
			{reverse {end "emit_body" 1}}
		}		
	}

	{sensor
		{visor "gun"
			{vision "cannon_main"}
			{bone "visor"}
		}
	}

	{placer
		{place "gunner"	 {visor "gun"}}
	}	
	
	{extender "inventory"
		{Box
			{item "bulletrus_76 aphebc" 39}	
			{item "bulletrus_76 he" 40}		
			{item "geballteladung_3kg" 1}
		}
	}	
	
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{weapon "76mm_f22" filling "bulletrus_76 aphebc" 12}
			{charger "charger charger2" minWorkers 1}
			{RestoreIKAfterAim}
			("abm_dymamic_gun"
				zeroing(2.00)
				dispersion(0.35)
			)
		}
	}
	
	{mass 7.5}	; 7.5tons empty
	{Chassis "wheel"
		("tank_trace_ex" fx("tracks_sm2") step(0.2) len(0.82) boneleft("FXtraceL3") boneright("FXtraceR3"))
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("mobility_car"
			speed(50) ;----------------------------------Max speed.
			speedatmaxturn(10) ;-------------------------Max speed at max turn.
			reverse(10) ;--------------------------------Max speed in Reverse.
			weight(9) ;------------------------------Weight in Tonnes.
			power(115) ;---------------------------------Horse Power.
			fuel(190) ;----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(110) ;---------------------------------Range in Kilometers.
		)
	}
	
	{bone "gun_rot"
		{limits -3 85}
		{speed2 15}
	}
	{bone "turret"
		{limits -35 35}
		{speed2 15}
	}	
}

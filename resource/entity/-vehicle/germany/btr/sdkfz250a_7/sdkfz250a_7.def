{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc" scale(1.0))
	{props "tank" "mortar" "halftrack" "with_gun" "wheeled" "open_top" "multi_board" "explosion_throw_crew" "vision_lev02" "tractor" "tractor_heavy" "detect_artillery_small" "open_death_fx_low" "artillery_minimap_light"}
	{able "emit_passengers_on_enemy"}
	{extension "sdkfz250a_1.mdl"}
	(include "sdkfz250a_1.ext")
	{patherId "sdkfz251"}
	{targetclass "armoredcar"}
	{targetSelector "tank_bullet"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	{boarder
		{anm "passenger1"
			{forward {begin "board_sdkfz250a"} {end "pose_sdkfz250a_passenger1"} {base "board"}}
			{reverse {end "emit_sd222_driver"} {base "board"}}
		}
		{anm "passenger2"
			{forward {begin "board_sdkfz250a"} {end "halftrack_pass_l_01_board_seat"} {base "board"}}
			{reverse {end "emit_sd222_driver"} {base "board"}}
		}
		{anm "passenger3"
			{forward {begin "board_sdkfz250a"} {end "halftrack_pass_l_02_board_seat"} {base "board"}}
			{reverse {end "emit_sd222_driver"} {base "board"}}
		}
		{anm "driver"
			{forward {begin "board_sdkfz250a"} {end "pose_sdkfz250a_driver"} {base "board"}}
			{reverse {end "emit_sd222_driver"} {base "board"}}
		}
		{anm "gunner"
			{forward {begin "board_sdkfz250a"} {end "pose_mortar_gunner"} {base "board"}}
			{reverse {end "emit_sd222_driver"} {base "board"}}
		}
		{anm "commander"
			{forward {begin "board_sdkfz250a"} {end "pose_mortar_commander"} {base "board"}}
			{reverse {end "emit_sd222_driver"} {base "board"}}
		}
	}

	("crew" place(driver)		bone(driver)	door(emit1)		animation(driver)		visor(driver)	off({sensor}))
	("crew" place(gunner)		bone(gunner)	door(emit1)		animation(gunner)		visor(main)		off({sensor}))
	("crew" place(commander)	bone(commander)	door(emit1)		animation(commander)		visor(none)		off({sensor}))

	{sensor
		{visor "human"
			{vision "none"}
		}
		{visor "around"
			{vision "none"}
		}
		{visor "main"
			{vision "cannon_mortar"}
			{bone "visor"}
		}
	}

	{extender "inventory"
		{Box
                        {item "repair_kit" 5}
			{item "mortarger_80 he" 41}
			{item "mortarger_80 sm" 15}
                        {item "panzerfaust_100 weapon" 2 filled}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{Barrels 1}
			{weapon "weapon 80mm_sgrw34" filling "mortarger_80 he" 1}
			{gunner "gunner"}
			{charger "commander"}
			{foresight "foresight"}
			("abm_dymamic_mortar"
				zeroing(3.0)	; // time it takes to aim until the reticle shrinks. Bigger values, more control.
				dispersion(1)	; // time it takes to distort the reticle when you move the gun (how abrupt it loses zeroing). Bigger values, more control.
			)
		}
	}

	{mass 5345}
	{Chassis "wheel"
		("tank_trace_ex" fx("tracks_sm2") step(0.2) len(0.29) boneleft("FXtraceL3") boneright("FXtraceR3"))
		("car_trace" fx("tracewheel03a") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))

		("mobility_car"
			speed(60) ;----------------------------------Max speed.
			speedatmaxturn(18) ;-------------------------Max speed at max turn.
			reverse(15) ;--------------------------------Max speed in Reverse.
			weight(5.6) ;-----------------------------Weight in Tonnes.
			power(100) ;---------------------------------Horse Power.
			fuel(140) ;----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(200) ;---------------------------------Range in Kilometers.
		)
	}
	
	{bone "turret"
		{limits -10 10}
		{speed2 20}
	}
	{bone "foresight"
		{limits -25 20}
		{speed2 10}
	}
}
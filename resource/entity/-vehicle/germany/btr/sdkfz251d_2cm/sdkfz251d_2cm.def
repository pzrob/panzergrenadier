{game_entity
	(include "/properties/armoredcar.ext")
	(include "/properties/selection/vehicle.inc" scale(1.0))
	{props "tank" "halftrack" "td" "muzzle_20mm_25mm_auto" "detect_tank_light" "shell_eject" "wheeled" "multi_board" "explosion_throw_crew" "vision_lev02" "tractor" "tractor_heavy" "open_death_fx_low" "emplacement_kfz13_trench"}
	{able "emit_passengers_on_enemy"}
	{extension "sdkfz251d_1.mdl"}
	(include "sdkfz251d_1.ext")
	{patherId "sdkfz251"}
	{targetclass "armoredcar"}
	{targetSelector "tank_bullet"}
	
	{extender "enumerator"
		{digit_folder "np"}
	}

	{boarder
		{anm "driver"
			{forward {begin "halftrack_driver_board"} {end "halftrack_driver_board_seat"} {base "board"}}
			{reverse {end "emit_sd222_driver"} {base "board"}}
		}
		{anm "gunner"
			{forward {begin "board_sd232_driver"} {end "seat_flak38_gunner"} {base "board"}}
			{reverse {end "emit_sd222_driver"} {base "board"}}
		}
		{anm "charger"
			{forward {begin "board_sd232_driver"} {end "seat_flak38_loader"} {base "board"}}
			{reverse {end "emit_sd222_driver"} {base "board"}}
		}
	}

	("crew" place(driver)		bone(driver)	door(emit1)		animation(driver)		visor(driver)	off({sensor}))
	("crew" place(gunner)		bone(gunner)	door(emit2)		animation(gunner)		visor(none)		off())
	("crew" place(charger)		bone(charger)	door(emit2)		animation(charger)		visor(none)		off())

	{sensor
		{visor "human"
			{vision "none"}
		}
		{visor "around"
			{vision "none"}
		}
	}

	{extender "inventory"
		{Box
			{item "bulletger_20_auto ap" 100}		; 14 clips (20 rounds each) 33/66 AP/HE
			{item "bulletger_20_auto he" 180}
		}
	}

	{Weaponry
		{place "gun"
			{weapon "20mm_flak38" filling "bulletger_20_auto he" 20}
			{charger "charger"}
			("abm_dymamic_aaa"
				zeroing(1.2)
				dispersion(0.15)
			)
		}
	}

	{mass 7810}
	{Chassis "wheel"
		("tank_trace_ex" fx("tracks_sm2") step(0.2) len(0.49) boneleft("FXtraceL3") boneright("FXtraceR3"))
		("car_trace" fx("tracewheel03a") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("mobility_car"
			speed(53) ;----------------------------------Max speed.
			speedatmaxturn(14) ;-------------------------Max speed at max turn.
			reverse(9) ;---------------------------------Max speed in Reverse.
			weight(7.81) ;--------------------------------Weight in Tonnes.
			power(100) ;---------------------------------Horse Power.
			fuel(160) ;----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(150) ;---------------------------------Range in Kilometers.
		)
	}
	
	{bone "gun_rot"
		{limits 0 -20}
		{speed2 60}
	}
	{bone "turret"
		{speed2 60}
	}
}